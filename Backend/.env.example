# 应用显示名称
APP_NAME=HappyMatch Backend
# 运行环境, local 表示本地开发
APP_ENV=local
# 后端 API 统一前缀
API_PREFIX=/api
# 本地服务监听地址
HOST=127.0.0.1
# 本地服务监听端口
PORT=8000
# SQLite 数据库连接地址
DATABASE_URL=sqlite:///./data/happymatch.db
# 是否打印 SQL 调试日志
SQL_ECHO=false
# 允许跨域访问的来源, 多个地址用英文逗号分隔
CORS_ORIGINS=http://localhost:49891,http://127.0.0.1:49891,http://localhost:8000
# 新游客玩家默认金币数量
DEFAULT_PLAYER_COINS=500
# 新游客玩家默认昵称
DEFAULT_GUEST_NICKNAME=糖果游客
# 好友码长度
FRIEND_CODE_LENGTH=8
# 附近人数在线统计窗口, 单位为秒
NEARBY_ACTIVE_SECONDS=300
# 附近人数粗粒度网格精度
NEARBY_GRID_PRECISION=2
# 开发环境密钥占位值, 后续登录签名时需要替换
SECRET_KEY=dev-only-change-me
# 是否开启 OpenAPI 文档
ENABLE_OPENAPI=true
# 高德开放平台 Web 服务 API Key
AMAP_WEB_SERVICE_KEY=
# 高德 Web 服务 API 基础地址
AMAP_WEB_SERVICE_BASE_URL=https://restapi.amap.com
# 高德定位失败或未配置 Key 时使用的兜底区域键
AMAP_FALLBACK_REGION_KEY=unknown
