APP_NAME=HappyMatch Backend
APP_ENV=local
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/happymatch.db
SQL_ECHO=false
CORS_ORIGINS=http://localhost:49891,http://127.0.0.1:49891,http://localhost:8000
DEFAULT_PLAYER_COINS=500
DEFAULT_GUEST_NICKNAME=糖果游客
FRIEND_CODE_LENGTH=8
NEARBY_ACTIVE_SECONDS=300
NEARBY_GRID_PRECISION=2
SECRET_KEY=dev-only-change-me
ENABLE_OPENAPI=true
